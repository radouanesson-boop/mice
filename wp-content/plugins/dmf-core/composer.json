{
    "name": "mcb/dmf-core",
    "description": "Destination Management Framework — modular WordPress framework for DMOs, Convention Bureaus and Tourism Boards.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.0",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "DMF\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "scripts": {
        "lint": "phpcs --standard=WordPress --extensions=php src/ templates/ config/ dmf-core.php",
        "analyse": "phpstan analyse src/ --level=6"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
