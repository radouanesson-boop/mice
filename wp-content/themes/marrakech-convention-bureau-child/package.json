{
  "name": "marrakech-convention-bureau-child",
  "version": "1.0.0",
  "description": "SCSS build tooling for the Marrakech Convention Bureau Brikk child theme.",
  "private": true,
  "scripts": {
    "build": "sass assets/scss/main.scss assets/css/main.css --style=compressed --source-map",
    "watch": "sass --watch assets/scss/main.scss assets/css/main.css --style=expanded --source-map",
    "lint:scss": "stylelint \"assets/scss/**/*.scss\" || true"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
